{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks-handlers/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "globalcontext checkpoint --context \"${CLAUDE_PROJECT_DIR}/.globalcontext.md\" --ai Claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "globalcontext checkpoint-complete --context \"${CLAUDE_PROJECT_DIR}/.globalcontext.md\" --ai Claude --clear-only"
          }
        ]
      }
    ]
  }
}
